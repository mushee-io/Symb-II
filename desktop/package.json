{
  "name": "symb-ii-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first, sandboxed Symb-II read-only trading terminal for internal acceptance.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:dir": "electron-builder --dir --publish never",
    "pack:win": "electron-builder --win nsis --x64 --publish never",
    "pack:mac": "electron-builder --mac dmg --publish never",
    "pack:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "xyz.mushee.symbii.desktop",
    "productName": "Symb-II Desktop",
    "files": [
      "main.cjs",
      "security-policy.cjs",
      "offline.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Symb-II-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "asar": true,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
