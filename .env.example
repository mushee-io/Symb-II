# Optional override for Ink mainnet public RPC
NEXT_PUBLIC_INK_RPC_URL=https://rpc-gel.inkonchain.com

# M5 optional: AI Gateway is disabled by default and refuses requests without all secrets below.
# The on-demand model path also requires a private Upstash Redis REST store for one-use nonce
# and atomic rate limits. Do not prefix any of these variables with NEXT_PUBLIC_.
SYMB_II_AI_ENABLED=false
AI_GATEWAY_API_KEY=
# Vercel deployments can authenticate AI Gateway automatically using OIDC;
# do not manually set VERCEL_OIDC_TOKEN in production.
# Vercel AI Gateway provider/model ID; verified fallback currently openai/gpt-5.6-luna
SYMB_II_AI_MODEL=openai/gpt-5.6-luna
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional opt-in daily scheduled risk snapshots; no push/email delivery is included.
# Requires a Vercel scheduled cron and authenticated Upstash REST store.
SYMB_II_WATCH_ENABLED=false
CRON_SECRET=

# M06 optional signed review receipts; false until private Upstash credentials are set.
# This never enables trading, transfers, order signing or token approvals.
SYMB_II_PROPOSALS_ENABLED=false

# Read-only transaction preflight and separately scoped signed acknowledgment.
# Requires private Redis credentials above. This never enables broadcasts or token approvals.
SYMB_II_PREFLIGHT_ENABLED=false
